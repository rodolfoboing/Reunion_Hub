rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isBanned() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('banned', false) == true;
    }

    function hasVerifiedEmail() {
      return isAuthenticated() && !isBanned() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isStaff() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') in ['admin', 'moderator'];
    }

    function hasEventTrust() {
      return isAuthenticated()
        && !isBanned()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('reputation', 0) > -50;
    }

    function isValidReportReason(type, reason) {
      return (type == 'event' && reason in [
        'Informação enganosa ou incorreta',
        'Local, data ou link inadequado',
        'Fraude ou pedido de dinheiro',
        'Risco à segurança ou atividade ilegal',
        'Conteúdo ofensivo ou discriminatório',
        'Outro motivo'
      ]) || (type == 'user' && reason in [
        'Assédio, ameaça ou perseguição',
        'Discurso de ódio ou discriminação',
        'Fraude ou pedido de dinheiro',
        'Conteúdo sexual ou inadequado',
        'Spam ou publicidade não solicitada',
        'Outro motivo'
      ]);
    }

    function editableUserFields() {
      return [
        'displayName', 'nick', 'searchName', 'bio', 'interests', 'photoURL',
        'showPopularOutsideInterests', 'shareFrequentedPlaces', 'favorites',
        'blockedUsers', 'isProfileComplete'
      ];
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'nick', 'searchName', 'email', 'reputation',
          'eventsAttended', 'foundedPlacesCount', 'showPopularOutsideInterests',
          'isProfileComplete', 'createdAt', 'interests', 'photoURL', 'bio',
          'shareFrequentedPlaces', 'favorites', 'blockedUsers',
          'termsVersion', 'termsAcceptedAt'
        ])
        && request.resource.data.searchName is string
        && request.resource.data.searchName.matches('^[a-z0-9._-]{3,20}$')
        && request.resource.data.termsVersion is string
        && request.resource.data.termsAcceptedAt is timestamp
        && existsAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.searchName))
        && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.searchName)).data.uid == request.auth.uid;
      allow update: if isOwner(userId) && !isBanned()
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(editableUserFields())
            && (
              !request.resource.data.diff(resource.data).affectedKeys().hasAny(['nick', 'searchName', 'displayName'])
              || (
                request.resource.data.searchName is string
                && request.resource.data.searchName.matches('^[a-z0-9._-]{3,20}$')
                && existsAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.searchName))
                && getAfter(/databases/$(database)/documents/nicknames/$(request.resource.data.searchName)).data.uid == request.auth.uid
              )
            )
            // Teto generoso: o app limita bio a 300 e interesses a 10, então isto
            // só barra abuso por script sem travar perfis antigos mais longos.
            && (!request.resource.data.keys().hasAny(['bio'])
              || (request.resource.data.bio is string && request.resource.data.bio.size() <= 1000))
            && (!request.resource.data.keys().hasAny(['interests'])
              || (request.resource.data.interests is list && request.resource.data.interests.size() <= 19))
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['expoPushToken'])
            && !request.resource.data.keys().hasAny(['expoPushToken'])
          )
          // Reaceite dos termos: ramo isolado de propósito, para que um save comum
          // de perfil não consiga reescrever a versão/data do aceite junto.
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['termsVersion', 'termsAcceptedAt'])
            && request.resource.data.termsVersion is string
            && request.resource.data.termsVersion.size() > 0
            && request.resource.data.termsVersion.size() <= 40
            && request.resource.data.termsAcceptedAt == request.time
          )
        );
      allow delete: if false;

      match /favoriteEvents/{eventId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /placeHabits/{placeId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /nicknames/{searchName} {
      allow get: if isAuthenticated();
      allow list: if false;
      allow create: if isAuthenticated() && !isBanned()
        && searchName.matches('^[a-z0-9._-]{3,20}$')
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow update: if isAuthenticated() && !isBanned()
        && searchName.matches('^[a-z0-9._-]{3,20}$')
        && resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'updatedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    match /pushTokens/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if false;
      allow delete: if isOwner(userId);
    }

    // Um documento por instalação permite vários celulares por conta. O ID é
    // criado localmente e permanece no aparelho; ao trocar de conta, o mesmo
    // documento muda de proprietário e deixa de receber dados da conta anterior.
    match /pushDevices/{deviceId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update: if isAuthenticated() && !isBanned()
        && deviceId.size() >= 20
        && deviceId.size() <= 100
        && request.resource.data.keys().hasOnly([
          'userId', 'expoPushToken', 'nativePushToken', 'platform', 'updatedAt'
        ])
        && request.resource.data.userId == request.auth.uid
        && (!request.resource.data.keys().hasAny(['expoPushToken'])
          || request.resource.data.expoPushToken == null
          || (request.resource.data.expoPushToken is string && request.resource.data.expoPushToken.size() <= 300))
        && (!request.resource.data.keys().hasAny(['nativePushToken'])
          || request.resource.data.nativePushToken == null
          || (request.resource.data.nativePushToken is string && request.resource.data.nativePushToken.size() <= 500))
        && (!request.resource.data.keys().hasAny(['platform'])
          || request.resource.data.platform == null
          || request.resource.data.platform in ['android', 'ios'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    match /notificationSettings/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) && !isBanned()
        && request.resource.data.keys().hasOnly([
          'notifyMessages', 'notifyEventUpdates', 'notifyEventReminders',
          'notifyRecommendations', 'recommendationLocation', 'updatedAt'
        ])
        && request.resource.data.notifyMessages is bool
        && request.resource.data.notifyEventUpdates is bool
        && request.resource.data.notifyEventReminders is bool
        && (!request.resource.data.keys().hasAny(['notifyRecommendations'])
          || request.resource.data.notifyRecommendations is bool)
        && (!request.resource.data.keys().hasAny(['recommendationLocation']) || (
          request.resource.data.recommendationLocation is map
          && request.resource.data.recommendationLocation.keys().hasOnly(['latitude', 'longitude', 'updatedAt'])
          && request.resource.data.recommendationLocation.latitude is number
          && request.resource.data.recommendationLocation.longitude is number
          && request.resource.data.recommendationLocation.latitude >= -90
          && request.resource.data.recommendationLocation.latitude <= 90
          && request.resource.data.recommendationLocation.longitude >= -180
          && request.resource.data.recommendationLocation.longitude <= 180
          && request.resource.data.recommendationLocation.updatedAt is timestamp
        ))
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(userId);
    }

    match /meetings/{meetingId} {
      allow read: if true;
      allow create: if hasVerifiedEmail()
        && hasEventTrust()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.keys().hasAll([
          'title', 'description', 'locationName', 'interests', 'date', 'time',
          'endDate', 'endTime', 'startsAt', 'endsAt', 'type', 'createdBy', 'attendees'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 3
        && request.resource.data.title.size() <= 100
        && request.resource.data.date is string
        && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.date >= '1900-01-01'
        && request.resource.data.time is string
        && request.resource.data.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && request.resource.data.endDate is string
        && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.endDate >= request.resource.data.date
        && request.resource.data.endTime is string
        && request.resource.data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && (request.resource.data.endDate > request.resource.data.date
          || request.resource.data.endTime > request.resource.data.time)
        && request.resource.data.startsAt is timestamp
        && request.resource.data.endsAt is timestamp
        && request.resource.data.startsAt > request.time
        && request.resource.data.endsAt >= request.resource.data.startsAt + duration.value(15, 'm')
        && request.resource.data.endsAt <= request.resource.data.startsAt + duration.value(24, 'h')
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() >= 1
        && request.resource.data.get('description', '').size() <= 2000
        && request.resource.data.get('locationName', '') is string
        && request.resource.data.get('locationName', '').size() >= 1
        && request.resource.data.get('locationName', '').size() <= 150
        && request.resource.data.get('interests', []) is list
        && request.resource.data.get('interests', []).size() >= 1
        && request.resource.data.get('interests', []).size() <= 10
        && request.resource.data.type in ['in-person', 'online']
        && (request.resource.data.type != 'in-person' || (
          request.resource.data.lat is number
          && request.resource.data.lng is number
          && request.resource.data.lat >= -90
          && request.resource.data.lat <= 90
          && request.resource.data.lng >= -180
          && request.resource.data.lng <= 180
        ))
        && (request.resource.data.type != 'online' || (
          request.resource.data.meetingLink is string
          && request.resource.data.meetingLink.matches('^https://.+')
          && request.resource.data.meetingLink.size() <= 500
        ))
        && request.resource.data.attendees is list
        && request.resource.data.attendees.size() == 1
        && request.resource.data.attendees[0] == request.auth.uid
        && !request.resource.data.keys().hasAny(['checkedIn'])
        && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status == 'active');
      allow update, delete: if false;
    }

    match /conversations/{conversationId} {
      allow create: if false;
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow update: if isAuthenticated() && !isBanned()
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessage', 'lastMessageTimestamp', 'lastSenderId', 'unreadCounts',
          'deletedBy', 'participantNames', 'updatedAt'
        ]);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated()
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow create, update, delete: if false;
      }
    }

    match /places/{placeId} {
      allow read: if true;
      allow write: if false;
    }

    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && !isBanned()
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated() && !isBanned()
        && request.resource.data.keys().hasOnly([
          'type', 'targetId', 'reportedBy', 'reason', 'conversationId', 'createdAt'
        ])
        && request.resource.data.type in ['event', 'user']
        && request.resource.data.targetId is string
        && request.resource.data.targetId.size() > 0
        && request.resource.data.targetId.size() <= 200
        && request.resource.data.reportedBy == request.auth.uid
        && reportId == request.resource.data.type + '_' + request.resource.data.targetId + '_' + request.auth.uid
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 120
        && isValidReportReason(request.resource.data.type, request.resource.data.reason)
        && request.resource.data.createdAt == request.time
        && (!request.resource.data.keys().hasAny(['conversationId'])
          || (request.resource.data.conversationId is string && request.resource.data.conversationId.size() <= 200))
        && ((request.resource.data.type == 'event'
          && exists(/databases/$(database)/documents/meetings/$(request.resource.data.targetId)))
          || (request.resource.data.type == 'user'
            && request.resource.data.targetId != request.auth.uid
            && exists(/databases/$(database)/documents/users/$(request.resource.data.targetId))));
      allow read: if isStaff() || (isAuthenticated() && resource.data.reportedBy == request.auth.uid);
      allow update, delete: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
