{
  "expo": {
    "name": "Reunion_Hub",
    "slug": "Reunion_Hub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/Whisk_Reunion_Hub_Logo.png",
    "scheme": "reunionhub",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/Whisk_Reunion_Hub_Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.rodolfoboing.reunionhub",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Whisk_Reunion_Hub_Logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Whisk_Reunion_Hub_Logo.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fa38a793-e86a-4cab-a779-3a9ef934f3db"
      }
    }
  }
}
