# Variáveis de ambiente do Reunion Hub
#
# Copie para `.env` (que é ignorado pelo Git) e preencha o que precisar.
# Tudo aqui tem o prefixo EXPO_PUBLIC_, ou seja: o Metro INLINA estes valores
# dentro do bundle. Eles são visíveis para quem abrir o app. Nunca coloque
# segredo de verdade em variável com este prefixo.
#
# Segredo real — service account, chave de servidor do FCM, keystore — nunca
# entra em .env nem no repositório.

# ---------------------------------------------------------------------------
# Firebase (cliente web/mobile)
# ---------------------------------------------------------------------------
# NÃO é obrigatório preencher: `src/services/firebaseConfig.js` já traz estes
# valores como padrão, para um clone novo rodar sem configuração. Defina-os
# apenas para apontar o app a OUTRO projeto Firebase (um ambiente de
# desenvolvimento separado, por exemplo) — a variável tem precedência.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Google Maps (somente build nativo Android)
# ---------------------------------------------------------------------------
# Esta fica FORA do repositório de propósito: diferente da config do Firebase,
# uma chave de Maps sem restrição gera cobrança real se alguém a usar, e bots
# varrem o GitHub atrás delas. Restrinja por pacote + SHA-1 no Google Cloud
# Console antes de usá-la em qualquer lugar.
#
# Não é necessária para rodar no navegador: `src/components/MapView.web.tsx` é
# um placeholder e o mapa não é renderizado na web.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# EAS / build
# ---------------------------------------------------------------------------
# Caminho alternativo para o google-services.json (config pública do Android).
# Sem isto, `app.config.js` usa ./google-services.json na raiz.
GOOGLE_SERVICES_JSON=
